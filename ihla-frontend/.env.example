# ---------------------------------------------------------------------------
# Intelligent Health Literacy Assistant — frontend configuration
#
# Copy to `.env` and adjust. Everything is optional: with no .env at all the
# app boots in Demo Mode and runs with no backend.
#
# Only variables prefixed VITE_ reach the browser. Never put a real secret in
# this file — anything here is readable by anyone who loads the page.
# ---------------------------------------------------------------------------

# --- Identity --------------------------------------------------------------
VITE_APP_NAME="Intelligent Health Literacy Assistant"
VITE_APP_SHORT_NAME="Health Literacy Assistant"
VITE_APP_VERSION="1.0.0"

# --- Mode ------------------------------------------------------------------
# demo      → local sample corpus, no network calls
# connected → real backend (requires VITE_API_BASE_URL below)
VITE_APP_MODE=demo

# Set false to pin a deployment to one mode and hide the switcher.
VITE_ALLOW_MODE_SWITCH=true

# --- Backend ---------------------------------------------------------------
# Base URL of the FastAPI service, no trailing slash.
# Leave empty to leave Connected Mode unconfigured — it will then fail loudly
# instead of silently showing demo content.
VITE_API_BASE_URL=http://localhost:8000

# Use "/api" together with VITE_USE_DEV_PROXY=true to route through the Vite
# dev proxy and avoid CORS during local development.
# VITE_USE_DEV_PROXY=true
# VITE_DEV_PROXY_TARGET=http://localhost:8000

# --- Authentication --------------------------------------------------------
# There is deliberately NO API key setting here.
#
# Vite inlines every VITE_* variable into the JavaScript bundle at build time,
# so anything placed here is served to the public and readable in DevTools. An
# API key in this file is a published secret, not a configured one.
#
# Authentication must stay server-side. Two supported patterns:
#   1. httpOnly session cookie issued by the backend -> set the flag below.
#   2. A server-side proxy / BFF that attaches the upstream credential.
# See FRONTEND_INTEGRATION_GUIDE.md section "Authentication".
VITE_API_WITH_CREDENTIALS=false

# --- Timeouts and limits ---------------------------------------------------
VITE_API_TIMEOUT_MS=30000
# Question answering runs retrieval + generation, so it gets a longer budget.
VITE_ASK_TIMEOUT_MS=90000
VITE_MAX_UPLOAD_BYTES=26214400

# --- Behaviour -------------------------------------------------------------
# Artificial latency for demo responses, so loading states are exercised.
VITE_DEMO_LATENCY_MS=900

# Shown in emergency safety notices. Change per deployment region.
VITE_EMERGENCY_NUMBER=112
