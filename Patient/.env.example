# Select: openai or ollama
HCL_LLM_PROVIDER=openai
HCL_LLM_MODEL=gpt-4o
HCL_LLM_TEMPERATURE=0

# Required for OpenAI. Keep real keys in .env (never commit it).
OPENAI_API_KEY=

# For local Llama 3 through Ollama:
# HCL_LLM_PROVIDER=ollama
# HCL_LLM_MODEL=llama3.2
# OLLAMA_NUM_CTX=1024
# OLLAMA_NUM_BATCH=16
# OLLAMA_BASE_URL=http://localhost:11434

# Optional LangSmith tracing. Configure only with your team's approved account.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=hcl-patient-interview
